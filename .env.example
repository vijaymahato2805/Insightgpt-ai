APP_ENV=development
APP_NAME=InsightGPT AI
API_PORT=8000
FRONTEND_PORT=5173

POSTGRES_DB=insightgpt
POSTGRES_USER=insightgpt
POSTGRES_PASSWORD=change-this-local-password
# Local backend runs use localhost; Docker Compose builds its internal URL from the POSTGRES_* values.
DATABASE_URL=postgresql+psycopg://insightgpt:change-this-local-password@localhost:5432/insightgpt

# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ENCRYPTION_KEY=
JWT_ACCESS_TOKEN_MINUTES=60
COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:5173

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SQL_MODEL=
REASONING_MODEL=
FAST_MODEL=
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=InsightGPT AI

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

SQLSERVER_ODBC_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_TRUST_SERVER_CERTIFICATE=false
SQLSERVER_CONNECTION_TIMEOUT_SECONDS=8
SCHEMA_DISCOVERY_MAX_OBJECTS=5000
SQL_QUERY_TIMEOUT_SECONDS=30
SQL_MAX_RESULT_ROWS=500
SQL_MAX_AST_NODES=1200
SQL_MAX_JOINS=8
